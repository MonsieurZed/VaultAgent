<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net9.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AssemblyName>VaultAgent-Setup</AssemblyName>
    <Version>2.1.1</Version>
    <ApplicationIcon>../assets/shield.ico</ApplicationIcon>
    <ApplicationManifest>setup.manifest</ApplicationManifest>
    <PublishSingleFile>true</PublishSingleFile>
    <SelfContained>true</SelfContained>
    <EnableCompressionInSingleFile>true</EnableCompressionInSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
    <EnableSingleFileAnalyzer>false</EnableSingleFileAnalyzer>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../ShieldIcon.cs" Link="ShieldIcon.cs" />
    <Compile Include="../UiText.cs" Link="UiText.cs" />
    <Compile Include="../UserPreferences.cs" Link="UserPreferences.cs" />
    <EmbeddedResource Include="../Localization/translations.json" LogicalName="VaultAgent.Translations.json" />
    <EmbeddedResource Include="../dist/payload.zip" LogicalName="VaultAgent.Payload.zip" />
    <PackageReference Include="System.ServiceProcess.ServiceController" Version="10.0.0" />
  </ItemGroup>
</Project>
